# Copy this file to .env and fill in real values from your Supabase
# project dashboard: Project Settings -> API. Never commit the real .env.
#
# SUPABASE_URL is always required -- used to fetch your project's public
# signing keys (JWKS) so tokens can be verified locally, without a
# network call to Supabase on every request.
#
# SUPABASE_JWT_SECRET is OPTIONAL. Only needed as a fallback if your
# project still uses the legacy HS256 shared-secret signing method
# (Project Settings -> API -> JWT Settings -> "JWT Secret"). Newer
# projects sign with ES256 by default and don't need this at all -- if
# you're unsure, leave it out and it'll just work via JWKS.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWT_SECRET=